<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>plumb — {{ .Title }}</title>
<style>
:root {
  --bg:          #0d1117; --bg-panel:    #161b22; --bg-hover:    #1c2128;
  --bg-selected: #1f2937; --border:      #30363d; --text:        #e6edf3;
  --text-muted:  #7d8590; --text-dim:    #484f58;
  --green:       #1a4731; --green-text:  #3fb950;
  --red:         #4a1e1e; --red-text:    #f85149;
  --yellow:      #3a2f00; --yellow-text: #d29922;
  --badge-bg:    #21262d;
  --font-mono: "JetBrains Mono","Fira Code",ui-monospace,monospace;
  --font-sans: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --radius: 6px;
}
@media (prefers-color-scheme: light) {
  :root {
    --bg:#fff; --bg-panel:#f6f8fa; --bg-hover:#eaeef2; --bg-selected:#dbeafe;
    --border:#d0d7de; --text:#1f2328; --text-muted:#656d76; --text-dim:#9198a1;
    --green:#dafbe1; --green-text:#1a7f37; --red:#ffebe9; --red-text:#cf222e;
    --yellow:#fff8c5; --yellow-text:#9a6700; --badge-bg:#eaeef2;
  }
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background:var(--bg); color:var(--text); font-family:var(--font-sans);
  font-size:13px; height:100vh; display:flex; flex-direction:column; overflow:hidden; }

header { background:var(--bg-panel); border-bottom:1px solid var(--border);
  padding:12px 20px; display:flex; align-items:center; gap:24px; flex-shrink:0; }
header h1 { font-size:14px; font-weight:600; }
header h1 .logo { color:var(--green-text); font-family:var(--font-mono); }
.summary-bar { display:flex; gap:20px; margin-left:auto; }
.stat { display:flex; flex-direction:column; align-items:flex-end; gap:2px; }
.stat-label { font-size:10px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); }
.stat-value { font-size:18px; font-weight:700; font-family:var(--font-mono); line-height:1; }
.stat-value.good { color:var(--green-text); } .stat-value.ok { color:var(--yellow-text); } .stat-value.bad { color:var(--red-text); }

.layout { display:flex; flex:1; overflow:hidden; }

.file-panel { width:300px; flex-shrink:0; border-right:1px solid var(--border);
  display:flex; flex-direction:column; overflow:hidden; }
.panel-toolbar { padding:8px 10px; border-bottom:1px solid var(--border);
  display:flex; flex-direction:column; gap:6px; }
.search-input { background:var(--bg); border:1px solid var(--border); border-radius:var(--radius);
  color:var(--text); font-size:12px; padding:5px 8px; width:100%; outline:none; }
.search-input:focus { border-color:var(--green-text); }
.sort-row { display:flex; gap:4px; }
.sort-btn { background:none; border:1px solid var(--border); border-radius:var(--radius);
  color:var(--text-muted); cursor:pointer; font-size:10px; padding:3px 7px;
  text-transform:uppercase; letter-spacing:.04em; }
.sort-btn.active { background:var(--bg-hover); border-color:var(--green-text); color:var(--green-text); }
.file-list { overflow-y:auto; flex:1; }
.file-item { cursor:pointer; padding:6px 10px; display:flex; align-items:center; gap:8px;
  border-bottom:1px solid var(--border); transition:background .1s; }
.file-item:hover { background:var(--bg-hover); }
.file-item.selected { background:var(--bg-selected); }
.file-name { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  font-family:var(--font-mono); font-size:11px; }
.file-pkg { font-size:9px; color:var(--text-dim); display:block; }
.pct-pill { font-size:10px; font-family:var(--font-mono); font-weight:600;
  padding:2px 6px; border-radius:10px; flex-shrink:0; }
.pct-pill.good { background:var(--green); color:var(--green-text); }
.pct-pill.ok   { background:var(--yellow); color:var(--yellow-text); }
.pct-pill.bad  { background:var(--red); color:var(--red-text); }

.source-panel { flex:1; display:flex; flex-direction:column; overflow:hidden; }
.empty-state { flex:1; display:flex; flex-direction:column; align-items:center;
  justify-content:center; color:var(--text-muted); gap:8px; }
.source-view { display:none; flex:1; flex-direction:column; overflow:hidden; }
.source-view.active { display:flex; }
.source-header { padding:8px 16px; border-bottom:1px solid var(--border);
  background:var(--bg-panel); display:flex; align-items:center; gap:12px; flex-shrink:0; }
.source-title { font-family:var(--font-mono); font-size:12px; font-weight:600; }
.source-stats { display:flex; gap:10px; margin-left:auto; font-size:11px; color:var(--text-muted); }
.source-stats .hi { color:var(--green-text); font-weight:600; font-family:var(--font-mono); }

.func-table-wrap { padding:10px 16px; border-bottom:1px solid var(--border);
  background:var(--bg-panel); flex-shrink:0; max-height:160px; overflow-y:auto; }
.func-table-title { font-size:10px; text-transform:uppercase; letter-spacing:.06em;
  color:var(--text-muted); margin-bottom:6px; }
.func-table { width:100%; border-collapse:collapse; font-size:11px; font-family:var(--font-mono); }
.func-table th { text-align:left; color:var(--text-muted); font-weight:500;
  padding:2px 8px 4px 0; border-bottom:1px solid var(--border); }
.func-table td { padding:3px 8px 3px 0; border-bottom:1px solid var(--border); }
.func-table tr:last-child td { border-bottom:none; }
.func-table td.count { color:var(--green-text); font-weight:600; }
.func-table td.count.zero { color:var(--red-text); }
.func-table td.lineno { color:var(--text-dim); }

.source-scroll { overflow:auto; flex:1; }
.source-table { width:100%; border-collapse:collapse; font-family:var(--font-mono);
  font-size:12px; line-height:1.6; }
.source-table tr.covered   { background:rgba(26,71,49,.35); }
.source-table tr.uncovered { background:rgba(74,30,30,.45); }
.source-table tr.changed   { outline:1px solid var(--yellow-text); outline-offset:-1px; }
.source-table tr:hover { filter:brightness(1.12); }
.diff-base { font-size:10px; font-weight:400; color:var(--text-muted); margin-left:8px; }
.skip-bar { padding:6px 20px; background:var(--bg-panel); border-bottom:1px solid var(--border);
  display:flex; flex-wrap:wrap; gap:4px 16px; font-size:11px; color:var(--text-muted); flex-shrink:0; }
.skip-label { font-weight:600; text-transform:uppercase; font-size:10px; letter-spacing:.04em; }
.lineno { color:var(--text-dim); padding:0 12px 0 16px; text-align:right;
  user-select:none; white-space:nowrap; width:1%; border-right:1px solid var(--border); }
.hitcount { color:var(--text-dim); padding:0 10px; text-align:right;
  user-select:none; white-space:nowrap; width:1%; font-size:10px; }
.hitcount.hit  { color:var(--green-text); }
.hitcount.miss { color:var(--red-text); }
.source-line { padding:0 16px 0 4px; white-space:pre; }
</style>
</head>
<body>

<header>
  <h1><span class="logo">plumb</span> — {{ .Title }}{{ if .Diff }}<span class="diff-base">vs {{ .DiffBase }}</span>{{ end }}</h1>
  <div class="summary-bar">
    {{ if .Diff }}
    <div class="stat">
      <span class="stat-label">Diff</span>
      <span class="stat-value {{ if .DiffMeasured }}{{ pctClass .DiffPct }}{{ end }}">{{ if .DiffMeasured }}{{ pct .DiffPct }}%{{ else }}{{ noCoverableLines }}{{ end }}</span>
    </div>
    {{ end }}
    <div class="stat">
      <span class="stat-label">Statements</span>
      <span class="stat-value {{ pctClass .StmtPct }}">{{ pct .StmtPct }}%</span>
    </div>
    <div class="stat">
      <span class="stat-label">Functions</span>
      <span class="stat-value {{ pctClass .FuncPct }}">{{ pct .FuncPct }}%</span>
    </div>
  </div>
</header>

{{ if .Skipped }}
<div class="skip-bar">
  <span class="skip-label">Left out of this report</span>
  {{ range .Skipped }}
  <span class="skip-item">{{ .Name }} — {{ .Reason }}</span>
  {{ end }}
</div>
{{ end }}

<div class="layout">

  <div class="file-panel">
    <div class="panel-toolbar">
      <input class="search-input" id="search" placeholder="Filter files…" oninput="filterFiles()">
      <div class="sort-row">
        <button class="sort-btn active" id="sort-pct"  onclick="sortFiles('pct')">Stmt %</button>
        <button class="sort-btn"        id="sort-func" onclick="sortFiles('func')">Func %</button>
        <button class="sort-btn"        id="sort-name" onclick="sortFiles('name')">Name</button>
      </div>
    </div>
    <div class="file-list" id="file-list">
      {{ range .Files }}
      <div class="file-item"
           data-id="{{ fileID .Name }}"
           data-name="{{ .ShortName }}"
           data-pct="{{ printf "%.4f" .StmtPct }}"
           data-func="{{ printf "%.4f" .FuncPct }}"
           onclick="selectFile('{{ fileID .Name }}', this)">
        <div class="file-name">
          <span class="file-pkg">{{ .Pkg }}</span>
          {{ .ShortName }}
        </div>
        {{ if $.Diff }}<span class="pct-pill {{ pctClass .DiffPct }}">{{ pct .DiffPct }}% diff</span>{{ end }}
        <span class="pct-pill {{ pctClass .StmtPct }}">{{ pct .StmtPct }}%</span>
      </div>
      {{ end }}
    </div>
  </div>

  <div class="source-panel">
    <div class="empty-state" id="empty-state">
      <p>Select a file to view source</p>
    </div>

    {{ range .Files }}
    <div class="source-view" id="{{ fileID .Name }}">
      <div class="source-header">
        <span class="source-title">{{ .Pkg }}/{{ .ShortName }}</span>
        <div class="source-stats">
          <span>stmts <span class="hi">{{ pct .StmtPct }}%</span></span>
          <span>funcs <span class="hi">{{ pct .FuncPct }}%</span></span>
        </div>
      </div>

      {{ if .Funcs }}
      <div class="func-table-wrap">
        <div class="func-table-title">Functions</div>
        <table class="func-table">
          <thead><tr><th>Name</th><th>Line</th><th>Calls</th></tr></thead>
          <tbody>
            {{ range .Funcs }}
            <tr>
              <td>{{ .Name }}</td>
              <td class="lineno">{{ .StartLine }}</td>
              <td class="count{{ if eq .Count 0 }} zero{{ end }}">
                {{- if gt .Count 0 }}×{{ .Count }}{{ else }}✗{{ end -}}
              </td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
      {{ end }}

      <div class="source-scroll">
        <table class="source-table">
          {{ range .Lines }}
          <tr class="{{ if eq .Status 1 }}covered{{ else if eq .Status 2 }}uncovered{{ end }}{{ if .Changed }} changed{{ end }}">
            <td class="lineno">{{ .Number }}</td>
            <td class="hitcount{{ if gt .Count 0 }} hit{{ else if eq .Status 2 }} miss{{ end }}">
              {{- if gt .Count 0 }}{{ .Count }}{{ else if eq .Status 2 }}0{{ end -}}
            </td>
            <td class="source-line">{{ .HTML }}</td>
          </tr>
          {{ end }}
        </table>
      </div>
    </div>
    {{ end }}
  </div>

</div>

<script>
function selectFile(id, el) {
  document.querySelectorAll('.source-view').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.file-item').forEach(i => i.classList.remove('selected'));
  document.getElementById('empty-state').style.display = 'none';
  document.getElementById(id).classList.add('active');
  el.classList.add('selected');
}

function filterFiles() {
  const q = document.getElementById('search').value.toLowerCase();
  document.querySelectorAll('.file-item').forEach(el => {
    el.style.display = el.dataset.name.toLowerCase().includes(q) ? '' : 'none';
  });
}

function sortFiles(by) {
  document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('sort-' + by).classList.add('active');
  const list = document.getElementById('file-list');
  const items = [...list.querySelectorAll('.file-item')];
  items.sort((a, b) => {
    if (by === 'name') return a.dataset.name.localeCompare(b.dataset.name);
    if (by === 'func') return parseFloat(a.dataset.func) - parseFloat(b.dataset.func);
    return parseFloat(a.dataset.pct) - parseFloat(b.dataset.pct);
  });
  items.forEach(el => list.appendChild(el));
}
</script>
</body>
</html>
